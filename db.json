  "practicalGuides": [
    {
      "id": "guide-001",
      "title": "Organización de rutinas",
      "category": "ROUTINE",
      "content": "Utilizar un calendario visual con actividades diarias y anticipar los cambios de rutina. Establecer horarios consistentes para las comidas, actividades educativas, descanso y recreación."
    },
    {
      "id": "guide-002",
      "title": "Apoyo durante momentos de crisis",
      "category": "CRISIS",
      "content": "Mantener un ambiente tranquilo, reducir los estímulos externos y seguir las indicaciones individualizadas del profesional. Evitar confrontaciones y proporcionar un espacio seguro para el niño."
    },
    {
      "id": "guide-003",
      "title": "Apoyo sensorial",
      "category": "SENSORY_SUPPORT",
      "content": "Identificar estímulos que generan incomodidad y ofrecer alternativas adaptadas a las preferencias del niño. Considerar ajustes de iluminación, sonidos y materiales según sus necesidades."
    },
    {
      "id": "guide-004",
      "title": "Reconocimiento de emociones",
      "category": "EMOTIONAL_SUPPORT",
      "content": "Utilizar imágenes y palabras sencillas para ayudar al niño a identificar y comunicar sus emociones. Realizar actividades de reconocimiento emocional mediante tarjetas, dibujos y situaciones cotidianas."
    }
  ],
